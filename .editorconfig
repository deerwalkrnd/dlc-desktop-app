root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Matches web/.prettierrc (useTabs) and the docs site's Prettier defaults.
[web/**]
indent_style = tab

[docs/**]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
